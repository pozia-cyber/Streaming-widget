<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp"
    android:orientation="vertical">
    <TextView
        android:id="@+id/w_idx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingLeft="9dp"
        android:paddingTop="2dp"
        android:paddingRight="9dp"
        android:paddingBottom="2dp"
        android:background="@drawable/chip_bg"
        android:text="NOW  19 / 20"
        android:textColor="#0670A8"
        android:textSize="11sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center|bottom"
        android:baselineAligned="false"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">
            <Chronometer
                android:id="@+id/w_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="00:00"
                android:textColor="#0D1A26"
                android:textSize="52sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingBottom="8dp"
            android:layout_marginLeft="16dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="종료까지"
                android:textColor="#566B7F"
                android:textSize="12sp" />
            <Chronometer
                android:id="@+id/w_remain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="02:59"
                android:textColor="#0670A8"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Star Trace"
        android:textColor="#0D1A26"
        android:textSize="24sp" />
    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:fadingEdgeLength="22dp"
        android:singleLine="true"
        android:requiresFadingEdge="horizontal"
        android:gravity="center"
        android:textColor="#566B7F"
        android:textSize="14sp" />
    <LinearLayout
        android:id="@+id/w_div"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="7dp"
        android:background="#D6E4EE"
        android:orientation="horizontal" />
    <TextView
        android:id="@+id/w_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:fadingEdgeLength="22dp"
        android:singleLine="true"
        android:requiresFadingEdge="horizontal"
        android:gravity="center"
        android:text="NEXT  Rewind"
        android:textColor="#566B7F"
        android:textSize="15sp" />
</LinearLayout>

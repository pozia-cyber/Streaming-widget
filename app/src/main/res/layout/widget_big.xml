            android:text="종료까지 "
            android:textColor="#566B7F"
            android:textSize="12sp" />

        <Chronometer
            android:id="@+id/w_remain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:59"
            android:textColor="#566B7F"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView

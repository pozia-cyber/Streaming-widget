<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/w_idx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOW  01 / 20"
        android:textColor="#0670A8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Star Trace"
        android:textColor="#0D1A26"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#566B7F"
        android:textSize="11sp" />

    <Chronometer
        android:id="@+id/w_pos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="#0D1A26"
        android:textSize="38sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="종료까지 "
            android:textColor="#566B7F"
            android:textSize="12sp" />

        <Chronometer
            android:id="@+id/w_remain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:59"
            android:textColor="#566B7F"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="NEXT  Rewind"
        android:textColor="#566B7F"
        android:textSize="12sp" />
</LinearLayout>
